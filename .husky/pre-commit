#!/usr/bin/env sh
# Keep the generated LLM files current whenever documentation changes.
# The generator regenerates static/llms-full.txt from docs/ and stamps the
# same Docs-Updated value (full ISO-8601, taken from the last commit) into
# both static/llms-full.txt and static/llms.txt, so the two files always
# carry an identical timestamp. Runs at commit time with your own
# credentials, so it needs no CI write access and works regardless of
# branch protection.
set -eu

# Only act when the staged changes touch documentation.
if git diff --cached --name-only | grep -qE '^docs/|^static/llms\.txt$|^static/llms-full\.txt$'; then
  if [ -f scripts/generate-llms-full.js ]; then
    node scripts/generate-llms-full.js
    git add static/llms-full.txt static/llms.txt
  fi
fi
